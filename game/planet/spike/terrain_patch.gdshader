shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

// Using ShaderMaterial per patch because sampler2D cannot be an instance uniform,
// and we need to pass the heightmap generated by the compute shader per-patch.
// For production, a Texture2DArray with an instance uniform index would be better.
uniform vec2 patch_offset;
uniform float patch_scale;
uniform int face_index;
uniform float planet_radius;
uniform float max_height;
uniform bool use_gpu_height;
uniform sampler2D height_map;
uniform vec3 patch_center_local;


// Exact same noise as CPU & Compute
vec3 hash33(vec3 p) {
    p = p * 0.1031;
    p -= floor(p);
    float dot_val = dot(p, vec3(p.z + 39.346, p.y + 39.346, p.x + 39.346));
    p += vec3(dot_val);
    vec3 res = vec3(p.x + p.y, p.x + p.z, p.y + p.z);
    return res - floor(res);
}

float get_noise_3d(vec3 p) {
    vec3 i = floor(p);
    vec3 f = p - i;
    vec3 u = f * f * (3.0 - 2.0 * f);
    float n000 = hash33(i).x;
    float n100 = hash33(i + vec3(1,0,0)).x;
    float n010 = hash33(i + vec3(0,1,0)).x;
    float n110 = hash33(i + vec3(1,1,0)).x;
    float n001 = hash33(i + vec3(0,0,1)).x;
    float n101 = hash33(i + vec3(1,0,1)).x;
    float n011 = hash33(i + vec3(0,1,1)).x;
    float n111 = hash33(i + vec3(1,1,1)).x;
    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);
    float nxy0 = mix(nx00, nx10, u.y);
    float nxy1 = mix(nx01, nx11, u.y);
    return mix(nxy0, nxy1, u.z) * 2.0 - 1.0;
}

float fbm(vec3 p, int octaves) {
    float value = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amp * get_noise_3d(p * freq);
        freq *= 2.0;
        amp *= 0.5;
    }
    return value;
}

float sample_height_analytic(vec3 dir) {
    vec3 warp = vec3(
        fbm(dir + vec3(1.2, 3.4, 5.6), 4),
        fbm(dir + vec3(7.8, 9.0, 1.2), 4),
        fbm(dir + vec3(3.4, 5.6, 7.8), 4)
    );
    float noise_val = fbm(dir * 2.0 + warp, 6);
    float ridged = 1.0 - abs(noise_val);
    return ridged * ridged;
}

vec3 get_spherified_dir(int face, vec2 face_uv) {
    vec2 p = face_uv * 2.0 - 1.0;
    vec3 v;
    if (face == 0) v = vec3(1.0, -p.y, -p.x);
    else if (face == 1) v = vec3(-1.0, -p.y, p.x);
    else if (face == 2) v = vec3(p.x, 1.0, p.y);
    else if (face == 3) v = vec3(p.x, -1.0, -p.y);
    else if (face == 4) v = vec3(p.x, -p.y, 1.0);
    else if (face == 5) v = vec3(-p.x, -p.y, -1.0);
    else v = vec3(0.0);
    
    float x2 = v.x * v.x;
    float y2 = v.y * v.y;
    float z2 = v.z * v.z;
    return normalize(vec3(
        v.x * sqrt(max(0.0, 1.0 - y2/2.0 - z2/2.0 + y2*z2/3.0)),
        v.y * sqrt(max(0.0, 1.0 - x2/2.0 - z2/2.0 + x2*z2/3.0)),
        v.z * sqrt(max(0.0, 1.0 - x2/2.0 - y2/2.0 + x2*y2/3.0))
    ));
}

varying float v_height;
varying vec3 v_normal;

void vertex() {
    // UV is grid 0..1
    vec2 face_uv = patch_offset + UV * patch_scale;
    vec3 dir = get_spherified_dir(face_index, face_uv);
    
    float h = 0.0;
    if (use_gpu_height) {
        h = texture(height_map, UV).r;
    } else {
        h = sample_height_analytic(dir);
    }
    
    v_height = h;
    
    // Displace vertex relative to center. The mesh is modeled around 0,0,0, but shifted per patch in GDScript.
    // Wait, the easiest is to have the grid at origin (0..1, 0..1), then the vertex shader computes the EXACT position 
    // in world space (relative to planet center), and we just subtract the patch center to keep float32 precision.
    
    // In GDScript, we will set the node's position to patch_center. 
    // So VERTEX must be: (dir * (planet_radius + h * max_height)) - patch_center
    // Wait, how do we pass patch_center in float32? We can pass it as a uniform, or just let GDScript set the transform.
    // If GDScript sets the node's Transform3D.origin to patch_center (relative to camera), 
    // then the model matrix handles the shift.
    // But then the vertex shader needs to know the vertex position relative to the planet center to sphere-map it!
    
    vec3 world_pos_from_center = dir * (planet_radius + h * max_height);
    
    // We pass patch_center_local (float32 approximation of the patch center relative to planet center).
    // The instance transform is set to (patch_center_double - camera_pos_double).
    // So the final vertex position is world_pos_from_center - patch_center_local.
    VERTEX = world_pos_from_center - patch_center_local;
    
    // Calculate normals using neighboring points
    // For a spike, simple analytical or texture derivatives would be better.
    // If we use GPU height, we need texture derivatives.
    // We'll compute it in fragment shader.
    v_normal = dir;
}

void fragment() {
    vec3 n = normalize(v_normal);
    
    // Simple slope coloring
    float slope = 1.0 - max(0.0, dot(n, normalize(v_normal))); // Simplified
    
    vec3 rock = vec3(0.3, 0.3, 0.3);
    vec3 grass = vec3(0.2, 0.5, 0.1);
    vec3 snow = vec3(0.9, 0.9, 0.9);
    
    vec3 col = mix(grass, rock, smoothstep(0.1, 0.3, v_height));
    if (v_height > 0.6) col = mix(col, snow, smoothstep(0.6, 0.8, v_height));
    
    ALBEDO = col;
    ROUGHNESS = 0.8;
}

