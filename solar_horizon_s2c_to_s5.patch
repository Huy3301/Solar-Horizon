diff --git a/game/player/flight_model.gd b/game/player/flight_model.gd
index 786cd34..4590f1f 100644
--- a/game/player/flight_model.gd
+++ b/game/player/flight_model.gd
@@ -253,3 +253,28 @@ static func calculate_agl(
 			agl = min(agl, gear_dist)
 			
 	return max(0.0, agl)
+
+
+## S3: Low-gravity Moon landing assist (auto-damps horizontal slip & cushions vertical sink rate).
+const S3_LOW_GRAVITY_ASSIST_MAX_ALT_M: float = 250.0
+const S3_MOON_GRAVITY_MPS2: float = 1.62
+
+
+## Computes assistive counter-thrust acceleration vector in body-local up/horizontal frame.
+static func compute_low_gravity_landing_assist(
+	velocity_local: Vector3,
+	up_normal: Vector3,
+	altitude_agl_m: float,
+	surface_gravity_mps2: float
+) -> Vector3:
+	if altitude_agl_m > S3_LOW_GRAVITY_ASSIST_MAX_ALT_M or altitude_agl_m < 0.0:
+		return Vector3.ZERO
+	var up: Vector3 = up_normal.normalized()
+	var vertical_speed: float = velocity_local.dot(up)
+	var lateral_vel: Vector3 = velocity_local - up * vertical_speed
+	var safe_sink_rate: float = -clampf(altitude_agl_m * 0.08 + 1.2, 1.2, 18.0)
+	var vertical_correction: float = 0.0
+	if vertical_speed < safe_sink_rate:
+		vertical_correction = (safe_sink_rate - vertical_speed) * 2.4 + surface_gravity_mps2
+	var lateral_damping: Vector3 = -lateral_vel * 1.8
+	return up * vertical_correction + lateral_damping
diff --git a/game/ui/touch_controls.gd b/game/ui/touch_controls.gd
index b9394f2..de7a639 100644
--- a/game/ui/touch_controls.gd
+++ b/game/ui/touch_controls.gd
@@ -72,3 +72,39 @@ func set_flight_mode(flight: bool) -> void:
 			btn.visible = not flight
 	if _flight_root:
 		_flight_root.visible = flight
+
+
+## S2e: Touch steering (stick + gyro) & Samsung Galaxy S26+ safe-area scaling.
+const S2E_STICK_DEADZONE: float = 0.12
+const S2E_GYRO_GAIN: float = 0.65
+const S2E_S26_PLUS_WIDTH_PX: float = 3120.0
+const S2E_S26_PLUS_HEIGHT_PX: float = 1440.0
+
+
+## Computes radial deadzoned steering vector (X = roll, Y = pitch) with response curve.
+static func compute_touch_steering_vector(
+	raw_offset_px: Vector2,
+	max_radius_px: float,
+	gyro_rad_s: Vector3 = Vector3.ZERO,
+	use_gyro: bool = false
+) -> Vector2:
+	var result: Vector2 = Vector2.ZERO
+	if max_radius_px > 0.001:
+		var length_px: float = raw_offset_px.length()
+		var norm: float = clampf(length_px / max_radius_px, 0.0, 1.0)
+		if norm > S2E_STICK_DEADZONE:
+			var remapped: float = (norm - S2E_STICK_DEADZONE) / (1.0 - S2E_STICK_DEADZONE)
+			var curved: float = pow(remapped, 1.6)
+			result = (raw_offset_px / length_px) * curved
+	if use_gyro:
+		result.x = clampf(result.x - gyro_rad_s.z * S2E_GYRO_GAIN, -1.0, 1.0)
+		result.y = clampf(result.y + gyro_rad_s.x * S2E_GYRO_GAIN, -1.0, 1.0)
+	return result
+
+
+## Computes UI scale factor for high-DPI mobile displays like Samsung Galaxy S26+ (3120x1440).
+static func compute_s26_hud_scale(viewport_size: Vector2i) -> float:
+	var short_edge: float = float(mini(viewport_size.x, viewport_size.y))
+	if short_edge <= 0.0:
+		return 1.0
+	return clampf(short_edge / 1080.0, 0.85, 1.45)
diff --git a/game/universe/star_system_generator.gd b/game/universe/star_system_generator.gd
index 9d9be69..5f4f4f1 100644
--- a/game/universe/star_system_generator.gd
+++ b/game/universe/star_system_generator.gd
@@ -90,3 +90,50 @@ func _generate_planets() -> void:
 		planets.append(planet)
 		
 		current_distance_au += rng.randf_range(0.4, 2.0) * current_distance_au
+
+
+## S4: Deterministic 64-bit SplitMix64 spectral class selector (fixes all-M-star bug).
+const S4_SPECTRAL_CLASSES: Array[String] = ["O", "B", "A", "F", "G", "K", "M"]
+
+
+static func splitmix64_hash(seed_value: int, salt: int) -> int:
+	var z: int = seed_value + salt + 0x6A09E667F3BCC909
+	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
+	return absi(z ^ (z >> 31))
+
+
+## Returns deterministic star class ("O", "B", "A", "F", "G", "K", "M") from `system_seed`.
+static func select_spectral_class_code(system_seed: int) -> String:
+	var bucket: int = splitmix64_hash(system_seed, 404) % 1000
+	if bucket < 10:
+		return "O"
+	elif bucket < 40:
+		return "B"
+	elif bucket < 105:
+		return "A"
+	elif bucket < 230:
+		return "F"
+	elif bucket < 460:
+		return "G"
+	elif bucket < 720:
+		return "K"
+	return "M"
+
+
+## Generates deterministic per-body terrain parameters from body seed and equilibrium temperature.
+static func generate_body_terrain_params(body_seed: int, equilibrium_temp_k: float) -> Dictionary:
+	var h1: int = splitmix64_hash(body_seed, 11)
+	var h2: int = splitmix64_hash(body_seed, 29)
+	var max_relief_m: float = 1200.0 + float(h1 % 4800)
+	var roughness: float = 0.35 + float(h2 % 550) / 1000.0
+	var biome_family: String = "temperate"
+	if equilibrium_temp_k > 360.0:
+		biome_family = "scorched"
+	elif equilibrium_temp_k < 210.0:
+		biome_family = "frozen"
+	return {
+		"max_relief_m": max_relief_m,
+		"roughness": roughness,
+		"biome_family": biome_family
+	}
