; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Solar Horizon"
config/description="Realistic solar system flight and exploration simulator starting from Adelaide Base, Australia."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus", "Mobile")

[autoload]

SimulationClock="*res://game/core/simulation_clock.gd"
SaveService="*res://game/autoload/save_service.gd"
GameManager="*res://game/autoload/game_manager.gd"
CraftingSystem="*res://game/gameplay/crafting_system.gd"
DiscoverySystem="*res://game/gameplay/discovery_system.gd"
ContractSystem="*res://game/gameplay/contract_system.gd"
StarCatalog="*res://game/universe/star_catalog.gd"
BaseBuilder="*res://game/gameplay/base_builder.gd"
TradeSystem="*res://game/gameplay/trade_system.gd"
FactionSystem="*res://game/gameplay/faction_system.gd"
QualityGovernor="*res://game/autoload/quality_governor.gd"
AccessibilityManager="*res://game/autoload/accessibility_manager.gd"
HapticsManager="*res://game/autoload/haptics_manager.gd"
OriginService="*res://game/core/origin_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

