@@ -141,3 +141,33 @@ func _apply_settings() -> void:
 			"scatter_density": scatter_density,
 			"cloud_render_distance": cloud_render_distance
 		})
+
+
+## S2e: Mobile terrain LOD budget (depth 8 = ~120 m vertex spacing) & ADPF thermal headroom step-down.
+const S2E_MOBILE_MAX_LOD_DEPTH: int = 8
+const S2E_DESKTOP_MAX_LOD_DEPTH: int = 16
+const S2E_THERMAL_WARN_HEADROOM: float = 0.85
+const S2E_THERMAL_CRITICAL_HEADROOM: float = 0.95
+const S2E_GPU_BUDGET_MS: float = 12.5
+
+
+## Returns the terrain quadtree max depth for the active platform/thermal state.
+static func get_terrain_max_lod_depth(is_mobile_platform: bool, thermal_headroom: float = 0.5) -> int:
+	if is_mobile_platform:
+		if thermal_headroom >= S2E_THERMAL_CRITICAL_HEADROOM:
+			return S2E_MOBILE_MAX_LOD_DEPTH - 1
+		return S2E_MOBILE_MAX_LOD_DEPTH
+	return S2E_DESKTOP_MAX_LOD_DEPTH
+
+
+## Computes recommended FSR 1.0 render scale based on ADPF thermal headroom and GPU frame time.
+static func compute_thermal_render_scale(
+	current_scale: float,
+	thermal_headroom: float,
+	avg_gpu_ms: float
+) -> float:
+	if thermal_headroom >= S2E_THERMAL_CRITICAL_HEADROOM:
+		return 0.60
+	if thermal_headroom >= S2E_THERMAL_WARN_HEADROOM or avg_gpu_ms > S2E_GPU_BUDGET_MS:
+		return maxf(0.60, current_scale - 0.05)
+	return clampf(current_scale, 0.60, 1.0)
diff --git a/game/fx/ship_vfx.gd b/game/fx/ship_vfx.gd
index 514b493..b09dc0e 100644
--- a/game/fx/ship_vfx.gd
+++ b/game/fx/ship_vfx.gd
@@ -335,3 +335,46 @@ func get_rcs_active(socket_name: String) -> bool:
 func get_atmosphere_density() -> float:
 	ensure_initialized()
 	return current_atmosphere_density
+
+
+## S2d: Speed-sensation cues (FOV kick, speed streaks, vignette, pulse tunnel, gear deploy).
+const S2D_BASE_FOV_DEG: float = 75.0
+const S2D_BOOST_FOV_KICK_DEG: float = 14.0
+const S2D_PULSE_FOV_KICK_DEG: float = 24.0
+const S2D_STREAK_MIN_SPEED_MPS: float = 40.0
+const S2D_STREAK_MAX_SPEED_MPS: float = 450.0
+
+
+## Computes deterministic S2d motion cues without per-frame allocations.
+static func compute_speed_sensation_metrics(
+	speed_mps: float,
+	is_boosting: bool,
+	is_pulse_active: bool
+) -> Dictionary:
+	var target_fov: float = S2D_BASE_FOV_DEG
+	if is_pulse_active:
+		target_fov += S2D_PULSE_FOV_KICK_DEG
+	elif is_boosting:
+		target_fov += S2D_BOOST_FOV_KICK_DEG
+	else:
+		target_fov += clampf(speed_mps / S2D_STREAK_MAX_SPEED_MPS, 0.0, 1.0) * 4.5
+
+	var streak_alpha: float = 0.0
+	if is_pulse_active:
+		streak_alpha = 1.0
+	elif speed_mps > S2D_STREAK_MIN_SPEED_MPS:
+		streak_alpha = clampf(
+			(speed_mps - S2D_STREAK_MIN_SPEED_MPS) / (S2D_STREAK_MAX_SPEED_MPS - S2D_STREAK_MIN_SPEED_MPS),
+			0.0,
+			1.0
+		)
+
+	var vignette: float = 0.35 if is_pulse_active else (0.18 if is_boosting else 0.0)
+	var plume_side_gain: float = clampf(0.48 + 0.52 * (speed_mps / 200.0), 0.48, 1.0)
+	return {
+		"target_fov_deg": target_fov,
+		"streak_alpha": streak_alpha,
+		"vignette_intensity": vignette,
+		"pulse_tunnel_mix": 1.0 if is_pulse_active else 0.0,
+		"plume_side_gain": plume_side_gain
+	}
diff --git a/game/gameplay/crafting_system.gd b/game/gameplay/crafting_system.gd
index aae6b42..5f742a8 100644
--- a/game/gameplay/crafting_system.gd
+++ b/game/gameplay/crafting_system.gd
@@ -126,3 +126,33 @@ func from_dict(data: Dictionary) -> void:
 		stats[str(k)] = float(st_dict[k])
 
 	stats_changed.emit(stats)
+
+
+## S3: Atomic crafting transaction helper (guarantees zero partial deductions on failure).
+static func execute_atomic_craft(
+	stock: Dictionary,
+	required_inputs: Dictionary,
+	output_item: String,
+	output_count: int = 1
+) -> bool:
+	if output_item.is_empty() or output_count <= 0:
+		return false
+	for ing_key: Variant in required_inputs.keys():
+		var item_id: String = str(ing_key)
+		var needed: int = int(required_inputs[ing_key])
+		if needed <= 0:
+			continue
+		if int(stock.get(item_id, 0)) < needed:
+			return false
+	for ing_key: Variant in required_inputs.keys():
+		var item_id: String = str(ing_key)
+		var needed: int = int(required_inputs[ing_key])
+		if needed <= 0:
+			continue
+		var left: int = int(stock.get(item_id, 0)) - needed
+		if left <= 0:
+			stock.erase(item_id)
+		else:
+			stock[item_id] = left
+	stock[output_item] = int(stock.get(output_item, 0)) + output_count
+	return true
